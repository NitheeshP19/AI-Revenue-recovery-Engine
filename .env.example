# ==============================================================================
#  AI Revenue Recovery System — Global Docker Compose Environment Variables
#  Rename this file to '.env' and populate with your keys.
# ==============================================================================

# ── PostgreSQL Config ────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# ── Groq LLM Agent Config ────────────────────────────────────────────────────
# Required for groq-agent container. Get your key from https://console.groq.com/
GROQ_API_KEY=gsk_your_actual_groq_api_key_here

# ── CORS Config ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=*
