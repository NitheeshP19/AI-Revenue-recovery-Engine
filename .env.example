# ==============================================================================
#  AI Revenue Recovery System — Global Docker Compose Environment Variables
#  Rename this file to '.env' and populate with your keys.
# ==============================================================================

# ── Application Environment ───────────────────────────────────────────────────
# Options: development | production
APP_ENV=development

# ── Neon Database Connection URL ─────────────────────────────────────────────
# Required by the Go ingestion API. Get from: https://console.neon.tech/
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-your-endpoint.neon.tech/neondb?sslmode=require

# ── PostgreSQL Config ─────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# ── LLM Agent Config (Google Gemini / Groq) ──────────────────────────────────
# Primary: Google Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional / Fallback: Groq API Key (get from https://console.groq.com/)
GROQ_API_KEY=gsk_your_actual_groq_api_key_here

# ── CORS Config ──────────────────────────────────────────────────────────────
# Restrict to your dashboard's actual origin. Use http://localhost:5173 locally.
ALLOWED_ORIGINS=http://localhost:5173
# Uncomment ONLY for local dev if you need to bypass origin restriction:
# ALLOW_INSECURE_CORS=true

# ── Razorpay Integration Config ──────────────────────────────────────────────
# Get test-mode keys from https://dashboard.razorpay.com/app/keys
# Test keys start with rzp_test_
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_test_secret_here
# Get this from Razorpay Dashboard > Settings > Webhooks (after creating a webhook)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
