# ============================================================
#  AI Revenue Recovery — Go Ingestion API
#  Copy this file to .env and fill in your values.
#  NEVER commit the real .env file to source control.
# ============================================================

# ── Database ───────────────────────────────────────────────
# Neon DB connection string. Get this from your Neon project dashboard.
# Format: postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgres://neondb_owner:YOUR_PASSWORD@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Server ─────────────────────────────────────────────────
PORT=8080
APP_ENV=development   # development | staging | production

# ── CORS ───────────────────────────────────────────────────
# Restrict to your dashboard's origin. Use http://localhost:5173 locally.
# Set ALLOW_INSECURE_CORS=true to allow all origins (dev only, never in production).
ALLOWED_ORIGINS=http://localhost:5173
# ALLOW_INSECURE_CORS=true

# ── Razorpay Integration ────────────────────────────────────
# Get test-mode keys from https://dashboard.razorpay.com/app/keys
# Test-mode keys start with rzp_test_
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_test_secret_here
# Create a webhook in Razorpay Dashboard > Settings > Webhooks
# and paste the generated secret here.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
