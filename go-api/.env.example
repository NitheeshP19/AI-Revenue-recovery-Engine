# ============================================================
#  AI Revenue Recovery — Go Ingestion API
#  Copy this file to .env and fill in your values.
#  NEVER commit the real .env file to source control.
# ============================================================

# ── Database ───────────────────────────────────────────────
# Neon DB connection string. Get this from your Neon project dashboard.
# Format: postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgres://neondb_owner:YOUR_PASSWORD@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Server ─────────────────────────────────────────────────
PORT=8080
APP_ENV=development   # development | staging | production

# ── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins for the React dashboard.
# Use * in development. ALWAYS restrict this in production.
# Example: ALLOWED_ORIGINS=https://your-dashboard.vercel.app
ALLOWED_ORIGINS=*
