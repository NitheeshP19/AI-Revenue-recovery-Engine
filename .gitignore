# ==============================================================================
#  AI Revenue Recovery System — Git Ignore Config
# ==============================================================================

# ── Environment & Secret Files ────────────────────────────────────────────────
# Ignore all environment configurations that contain sensitive credentials
.env
.env.local
.env.*
!.env.example

# ── Python Cache & Venv ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo

# Virtual Environments
.venv/
venv/
env/
ENV/

# ── Node / Frontend dependencies ──────────────────────────────────────────────
node_modules/
dist/
.eslintcache

# ── Operating System Files ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Generated Simulation Output ───────────────────────────────────────────────
metrics_summary.json

# ── Local scratch / IDE artifacts ─────────────────────────────────────────────
scratch/
walkthrough.md
